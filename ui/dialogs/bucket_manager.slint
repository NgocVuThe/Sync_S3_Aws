import { Button, VerticalBox, LineEdit, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../shared/colors.slint";
import { BucketConfigItem } from "../shared/types.slint";

export component BucketManagerDialog inherits Rectangle {
    in-out property <[BucketConfigItem]> bucket-list;
    in-out property <string> new-bucket-name;
    in-out property <string> new-distribution-id;
    in-out property <int> editing-index: -1;
    in-out property <string> error-message;
    in-out property <bool> show-add-input: false;
    
    callback add-bucket(string, string);
    callback update-bucket(int, string, string);
    callback delete-clicked(int, string);
    callback close();

    background: #000000cc;
    TouchArea { } // Block clicks behind

    Rectangle {
        x: (parent.width - 520px) / 2;
        height: Math.min(600px, 120px + Math.min(350px, bucket-list.length * 80px) + (show-add-input ? 140px : 60px) + (error-message != "" ? 30px : 0px));
        y: (parent.height - self.height) / 2;
        width: 520px;
        background: Theme.bg-tertiary;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.border-default;
        animate height { duration: 200ms; easing: ease-out; }
        
        VerticalBox {
            padding: 24px;
            spacing: 20px;
            
            HorizontalLayout {
                alignment: center;
                height: 32px;
                Text { text: "Manage S3 Buckets & CloudFront"; font-size: 18px; font-weight: 800; color: Theme.accent-blue; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: close-ta.has-hover ? Theme.accent-red : Theme.text-secondary;
                        background: close-ta.has-hover ? #e06c7522 : transparent;
                        animate background, border-color { duration: 150ms; }
                        close-ta := TouchArea { clicked => { close(); } mouse-cursor: pointer; }
                        Text { text: "X"; font-size: 12px; font-weight: 700; color: close-ta.has-hover ? Theme.accent-red : Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-default;
                height: Math.min(350px, bucket-list.length * 80px + 20px);
                animate height { duration: 200ms; }
                
                ScrollView {
                    VerticalBox {
                        padding: 10px;
                        spacing: 10px;
                        alignment: start;
                        for bucket[index] in bucket-list : Rectangle {
                            height: 90px;
                            background: Theme.bg-card;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                
                                if (editing-index == index) : VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    LineEdit {
                                        text <=> new-bucket-name; placeholder-text: "Bucket name"; font-size: 14px; height: 28px;
                                    }
                                    LineEdit {
                                        text <=> new-distribution-id; placeholder-text: "Distribution ID"; font-size: 12px; height: 28px;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Button {
                                            text: "Save"; primary: true; width: 60px; height: 24px;
                                            clicked => { update-bucket(index, new-bucket-name, new-distribution-id); }
                                        }
                                        Button {
                                            text: "Esc"; width: 50px; height: 24px;
                                            clicked => { editing-index = -1; new-bucket-name = ""; new-distribution-id = ""; }
                                        }
                                    }
                                }
                                
                                if (editing-index != index) : VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    Text { text: bucket.name; color: Theme.text-primary; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { 
                                        text: bucket.distribution-id == "" ? "No Distribution ID" : "CF: " + bucket.distribution-id; 
                                        color: bucket.distribution-id == "" ? Theme.text-secondary : Theme.accent-green; 
                                        font-size: 12px; 
                                        overflow: elide; 
                                    }
                                }
                                
                                if (editing-index != index) : VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Button {
                                        text: "Edit"; width: 50px; height: 24px;
                                        clicked => { new-bucket-name = bucket.name; new-distribution-id = bucket.distribution-id; editing-index = index; }
                                    }
                                    Button {
                                        text: "Del"; width: 50px; height: 24px;
                                        clicked => { delete-clicked(index, bucket.name); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 12px;
                alignment: center;
                
                if (!show-add-input) : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 48px; height: 48px; background: add-btn-ta.has-hover ? Theme.accent-blue : Theme.border-default; border-radius: 24px;
                        animate background { duration: 200ms; }
                        add-btn-ta := TouchArea { clicked => { show-add-input = true; new-bucket-name = ""; new-distribution-id = ""; error-message = ""; } mouse-cursor: pointer; }
                        Text { text: "+"; font-size: 32px; color: add-btn-ta.has-hover ? Theme.bg-secondary : white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                
                if (show-add-input) : VerticalLayout {
                    spacing: 10px;
                    alignment: center;
                    LineEdit {
                        text <=> new-bucket-name; placeholder-text: "Bucket name..."; horizontal-stretch: 1; height: 36px;
                    }
                    LineEdit {
                        text <=> new-distribution-id; placeholder-text: "CloudFront Distribution ID (optional)"; horizontal-stretch: 1; height: 36px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        Button { text: "Add"; primary: true; width: 80px; height: 36px; clicked => { add-bucket(new-bucket-name, new-distribution-id); } }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 28px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: cancel-add-ta.has-hover ? Theme.accent-red : Theme.border-default;
                                background: cancel-add-ta.has-hover ? #e06c7522 : transparent;
                                animate background, border-color { duration: 150ms; }
                                cancel-add-ta := TouchArea { clicked => { show-add-input = false; new-bucket-name = ""; new-distribution-id = ""; } mouse-cursor: pointer; }
                                Text { text: "X"; font-size: 14px; font-weight: 700; color: cancel-add-ta.has-hover ? Theme.accent-red : white; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            if (error-message != "") : Text { text: error-message; color: Theme.accent-red; font-size: 13px; font-weight: 500; horizontal-alignment: center; }
        }
    }
}